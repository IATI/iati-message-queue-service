    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Consumer - service loop",
            "type": "debugpy",
            "request": "launch",
            "program": "sample-python-apps/src/consumer_azsb_library.py",
            "args": [
                "--num-messages-to-receive",
                "2",
                "--run-as-service-loop",
            ],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/sample-python-apps/.env"
        },

    ]
}